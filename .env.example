# =============================================================================
# Web3 Crew AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file. It is in .gitignore.
# =============================================================================

# --- LLM Provider (multi-provider via litellm / CrewAI) ---
# Supported providers: gemini (default), cerebras.
# Switching is a pure env-var change — set LLM_PROVIDER and the matching
# *_API_KEY below. The factory picks a sane default model per provider, or
# you can pin a specific one with LLM_MODEL.
LLM_PROVIDER=gemini

# --- Provider: Google Gemini (free tier, AI Studio) ---
# Get an API key at https://aistudio.google.com/app/apikey
# Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your-google-gemini-api-key-here

# --- Provider: Cerebras Cloud (free tier, super-fast Llama/GPT-OSS) ---
# Get an API key at https://cloud.cerebras.ai (Google SSO works).
# Required when LLM_PROVIDER=cerebras. Safe to leave empty otherwise.
CEREBRAS_API_KEY=

# Optional model override. Leave blank to use the provider's default:
#   gemini   -> gemini/gemini-2.5-flash
#   cerebras -> cerebras/llama3.1-8b
# Other valid examples:
#   LLM_MODEL=gemini/gemini-2.5-pro              # paid Gemini
#   LLM_MODEL=cerebras/gpt-oss-120b              # bigger Cerebras model (slower, stronger)
#   LLM_MODEL=cerebras/qwen-3-235b-a22b-instruct-2507  # preview model on Cerebras
LLM_MODEL=

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# --- Blockchain RPC ---
WEB3_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# --- Block Explorer ---
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# --- Wallet (NEVER share this with anyone) ---
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# --- Chain Configuration ---
CHAIN_ID=1

# --- Optional: DexScreener (public API, key optional) ---
# DEXSCREENER_API_KEY=your-key-if-needed

# --- Optional: Alchemy NFT API for post-mint metadata enrichment ---
# When set, after a successful /mint the bot fetches the NFT name, image,
# and traits from Alchemy's getNFTMetadata endpoint and displays them in
# the Telegram success message alongside the tx hash. When empty, the
# bot still shows the tx hash + Etherscan + OpenSea links — just without
# the rich metadata. Get a free key at https://dashboard.alchemy.com/.
# Supported chains: Ethereum mainnet (1), Polygon (137), Base (8453),
# Arbitrum (42161), Optimism (10).
ALCHEMY_API_KEY=

# --- Gas War — EIP-1559 dynamic fees ---
# Strategy multiplier applied to the chain's suggested priority fee.
#   slow=1.0x, standard=1.5x, fast=2.0x (default), aggressive=3.0x
# Use 'aggressive' for contested mints / NFT drops.
GAS_STRATEGY=fast

# Hard cap on maxPriorityFeePerGas in gwei. Prevents runaway costs during
# volatile network conditions. 5 is reasonable on Ethereum mainnet; bump
# higher (e.g. 20–50) on L2s or during NFT mints if you really want to win.
MAX_PRIORITY_FEE_GWEI=5

# --- Anti-MEV: Flashbots Protect ---
# Optional. When set, signed transactions are submitted through Flashbots'
# private mempool so MEV bots cannot sandwich or frontrun them. Free, no
# auth. Mainnet only — leave blank on other chains.
#   FLASHBOTS_RPC_URL=https://rpc.flashbots.net
FLASHBOTS_RPC_URL=

# --- Defensive Execution ---
# Per-transaction worst-case cost budget in ETH. Before signing, the
# executor refuses to submit any transaction whose
#   gas_limit * max_fee_per_gas
# exceeds this value. Default 0.05 ETH (~$150 at ETH=$3k) is a sane cap
# for one-off mints; raise it deliberately for high-value drops.
MAX_TX_COST_ETH=0.05

# How long the executor waits for the receipt before treating the tx as
# stuck. A stuck tx is reported with status="pending" plus tx_hash, nonce,
# and an explorer link so you can replace or cancel it.
TX_WAIT_SECONDS=120

# Opt-in Replace-By-Fee. When true and a tx is stuck after TX_WAIT_SECONDS,
# the executor automatically resubmits the same nonce with a 1.5x-bumped
# priority fee, up to MAX_RBF_ATTEMPTS times. Each retry still respects
# MAX_PRIORITY_FEE_GWEI and MAX_TX_COST_ETH so it cannot drain the wallet.
ENABLE_AUTO_RBF=false

# Maximum number of RBF retries when ENABLE_AUTO_RBF=true. 1 means: one
# original submission plus one bumped resubmission. Ignored otherwise.
MAX_RBF_ATTEMPTS=1

# --- Telegram Bridge (only needed for `python -m web3_crew.telegram_bot`) ---
# Get a bot token by talking to @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID. Find yours by messaging @userinfobot.
# The bot drops EVERY update whose sender ID does not exactly match this value.
# Leaving this at 0 disables the bot.
AUTHORIZED_USER_ID=0
