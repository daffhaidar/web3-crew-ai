# =============================================================================
# Web3 Crew AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file. It is in .gitignore.
# =============================================================================

# --- LLM Provider (Google Gemini via litellm / CrewAI) ---
# Get an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# LiteLLM-compatible model identifier. Default targets gemini-2.5-flash so it
# works on Google's free tier (gemini-1.5-pro has been retired; '*-pro' models
# now require a billing-enabled AI Studio project as of late-2025).
# To use a paid pro model, enable billing then set:
#   LLM_MODEL=gemini/gemini-2.5-pro
LLM_MODEL=gemini/gemini-2.5-flash

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# --- Blockchain RPC ---
WEB3_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# --- Block Explorer ---
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# --- Wallet (NEVER share this with anyone) ---
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# --- Chain Configuration ---
CHAIN_ID=1

# --- Optional: DexScreener (public API, key optional) ---
# DEXSCREENER_API_KEY=your-key-if-needed

# --- Telegram Bridge (only needed for `python -m web3_crew.telegram_bot`) ---
# Get a bot token by talking to @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID. Find yours by messaging @userinfobot.
# The bot drops EVERY update whose sender ID does not exactly match this value.
# Leaving this at 0 disables the bot.
AUTHORIZED_USER_ID=0
